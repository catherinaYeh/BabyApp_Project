# --- Database (Supabase) ---
# Runtime queries -> Supabase transaction pooler (port 6543).
# Append ?pgbouncer=true&connection_limit=1&sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
# Migrations/introspection -> Supabase session pooler (port 5432). Required by
# `prisma migrate`; the migration engine cannot run through the 6543 pooler.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Local dev alternative (docker-compose postgres): point both at localhost.
# DATABASE_URL=postgresql://baby:baby_dev@localhost:5432/baby_weaning?schema=public
# DIRECT_URL=postgresql://baby:baby_dev@localhost:5432/baby_weaning?schema=public

PORT=3000
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
NODE_ENV=development
